# Variables of deploy/compose.yaml (copy to deploy/.env; without it, `docker compose config`
# still works with the defaults).
# --- Where the Docker daemon runs ---
# Where the TES runner of yai-tes starts containers (same syntax as DOCKER_HOST of the docker CLI):
#   rootless daemon: unix:///run/user/<uid>/docker.sock (visible to yai-tes) /
#   dedicated VM: ssh://user@vm or tcp://vm:2376 / dind: tcp://dind:2376
YAI_DOCKER_HOST=
# TES working directory: as compose sees it (bind mount source) and as the Docker daemon sees it
YAI_TES_WORK_DIR=./local/tes-work
YAI_TES_WORK_DIR_FOR_DOCKER=/srv/yai/tes-work
# --- Published port ---
YAI_BIND=127.0.0.1
YAI_HTTPS_PORT=8443
# --- User (owner of created files; match it for rootless Docker and Podman) ---
YAI_UID=10001
YAI_GID=10001
# --- Other ---
YAI_PROJECT=yai
YAI_NETWORK=yai-net
YAI_LOCAL_DIR=./local
YAI_IMAGE=yai:dev
YAI_TEST_IMAGE=yai-test:dev
YAI_CADDY_IMAGE=caddy:2.11.7-alpine
