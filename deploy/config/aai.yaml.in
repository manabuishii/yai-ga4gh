# yai-aai (combined tests). setup.sh replaces @...@ with secrets and writes local/config/aai.yaml
issuer: https://aai.yai.test/
keys_dir: /yai/var/aai/keys
test_endpoints: true            # /test/login only (used by the compose e2e and the interop clients, D-054)
passport_aud: [yai-drs]
ttl: {access_token: 900, psat: 900, passport: 7200, visa: 7200}
users:
  alice:   {scopes: [wes.run, wes.read, wes.cancel, tes.submit, tes.read, tes.cancel, drs.read, drs.access],
            visas: [{value: "https://yai.test/datasets/ds1"}]}
  bob:     {scopes: [wes.run, wes.read, wes.cancel, tes.submit, tes.read, tes.cancel, drs.read, drs.access],
            visas: [{value: "https://yai.test/datasets/ds2"}]}
  carol:   {scopes: []}
  mallory: {scopes: [wes.run, wes.read], visas: [{value: "https://yai.test/datasets/ds1", issuer: untrusted}]}
clients:
  yai-test-client: {secret: "@TEST_CLIENT_SECRET@"}
  yai-wes: {secret: "@WES_CLIENT_SECRET@", audiences: [yai-tes, yai-drs],
            scopes: [tes.submit, tes.read, tes.cancel, tes.delegate]}
