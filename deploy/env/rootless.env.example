# Example values for running the compose stack on a rootless Docker daemon whose socket and
# working directory are shared with the machine where you run these scripts (D-037).
# Copy to deploy/env/rootless.env (ignored by git) and adjust the paths; no secrets go here.
# Usage: tools/compose_e2e.sh and tools/interop.sh read deploy/env/rootless.env by default.
#
# A working directory that the Docker daemon sees at the same path as you do.
YAI_LOCAL_DIR=/srv/yai-docker-work/yai/local
# With rootless Docker, uid 0 in a container is the daemon's user on the host; only 0:0 can
# write to the working directory (D-034).
YAI_UID=0
YAI_GID=0
YAI_TES_JOB_USER=0:0
# The TES working directory as the daemon sees it (same path here, so no translation).
YAI_TES_WORK_DIR_FOR_DOCKER=/srv/yai-docker-work/yai/local/tes-work
# The directory that holds the daemon's socket, as seen by the daemon (host path).
YAI_DOCKER_SOCK_DIR=/run/user/1001/docker
# The socket as seen from inside the containers (compose mounts the directory at /run/yai-docker).
YAI_DOCKER_HOST=unix:///run/yai-docker/docker.sock
