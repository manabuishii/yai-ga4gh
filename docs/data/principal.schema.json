{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yai.test/schema/principal.schema.json",
  "title": "4 つの役の入出力の形(design/aai.md 2 節)",
  "$defs": {
    "AcceptedVisa": {
      "type": "object",
      "description": "検査に通った Visa。トークンそのものは持たない",
      "required": ["iss", "sub", "type", "value", "source", "asserted", "exp", "jti"],
      "properties": {
        "iss": {"type": "string"},
        "sub": {"type": "string"},
        "type": {"type": "string"},
        "value": {"type": "string"},
        "source": {"type": "string"},
        "by": {"type": ["string", "null"]},
        "asserted": {"type": "integer"},
        "exp": {"type": "integer"},
        "jti": {"type": "string", "description": "jti、無ければ署名の SHA-256 の先頭 16 文字"}
      },
      "additionalProperties": false
    },
    "VerifiedCredential": {
      "type": "object",
      "description": "R1 の出力の 1 つ",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["none", "at_user", "at_service", "passport", "static_bearer"]},
        "iss": {"type": "string"},
        "sub": {"type": "string"},
        "scopes": {"type": "array", "items": {"type": "string"}},
        "exp": {"type": ["integer", "null"]},
        "visas": {"type": "array", "items": {"$ref": "#/$defs/AcceptedVisa"}},
        "client_id": {"type": ["string", "null"]},
        "actor": {"type": ["string", "null"], "description": "act.sub of a delegated AT: the service acting for sub (D-067)"}
      }
    },
    "Principal": {
      "type": "object",
      "description": "R2 の出力。身元は (iss, sub) の組",
      "required": ["iss", "sub", "kind", "scopes", "visas"],
      "properties": {
        "iss": {"type": "string"},
        "sub": {"type": "string"},
        "kind": {"enum": ["user", "service", "anonymous"]},
        "scopes": {"type": "array", "items": {"type": "string"}},
        "visas": {"type": "array", "items": {"$ref": "#/$defs/AcceptedVisa"}},
        "actor": {"type": ["string", "null"], "description": "sub of the service acting for this user (act.sub of the AT, D-067); null when the subject acts for itself"}
      },
      "additionalProperties": false
    },
    "Decision": {
      "description": "R3 の出力。forbidden=403、not_visible=404(D-013)",
      "enum": ["allow", "forbidden", "not_visible"]
    },
    "Downstream": {
      "type": "object",
      "description": "R4 の出力。下流の要求に付けるもの",
      "properties": {
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "body": {"type": "object"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/Principal"},
    {"$ref": "#/$defs/VerifiedCredential"},
    {"$ref": "#/$defs/Decision"},
    {"$ref": "#/$defs/Downstream"}
  ]
}
